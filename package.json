{
  "name": "@sonojs/geo",
  "version": "0.1.0",
  "description": "Countries, states, and cities for JavaScript — lazy-loaded geographic data with TypeScript types",
  "license": "MIT",
  "author": "SonoJS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SonoJS/SonoJS-geo.git"
  },
  "homepage": "https://sonojs.github.io/SonoJS-geo/",
  "bugs": {
    "url": "https://github.com/SonoJS/SonoJS-geo/issues"
  },
  "keywords": [
    "sonojs",
    "geo",
    "countries",
    "states",
    "cities",
    "geography",
    "iso3166",
    "world"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "data",
    "LICENSE",
    "ODbL-1.0.txt",
    "NOTICE.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/node.d.ts",
      "node": "./dist/node.js",
      "default": "./dist/browser.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:data": "node scripts/build-data.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "measure:sizes": "node scripts/measure-sizes.mjs",
    "build:ts": "tsc",
    "build": "npm run build:data && npm run validate:data && npm run build:ts",
    "test": "npm run build:ts && node --import tsx --test test/**/*.test.ts",
    "test:consumers": "node scripts/run-consumer-tests.mjs",
    "test:pages": "node scripts/test-pages-subpath.mjs",
    "dev": "npm run build:ts && npx --yes serve .",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "publishConfig": {
    "access": "public"
  }
}